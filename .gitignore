# Root allowlist: keep the public repository limited to source and required resources.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/AGENTS.md
!/cjpm.toml
!/cjpm.lock
!/build.cj
!/run.cmd
!/src/
!/tools/
!/assets/
!/vendor/
!/licenses/
!/docs/

# Personal songs, local databases and preferences are never published.
/Songs/
/settings.cfg
/data/
*.osz
*.db
*.tsv

# Build products, SDKs, caches, recordings and local experiment files.
/target/
/build-script-cache/
/artifacts/
/.tools/
**/target/
**/build-script-cache/
**/__pycache__/
**/*.pyc
**/.git/
**/.DS_Store
**/Thumbs.db
.env
.env.*
*.pem
*.key
*.log

# Icons are recreated from assets/branding/icon.svg by the build hook.
/assets/generated/

# Publish current README media and the maintained UI contract only.
/docs/*
!/docs/UI_GUIDELINES.md
!/docs/media/
/docs/media/*
!/docs/media/gameplay.gif
!/docs/media/library.gif
!/docs/media/settings.png
!/docs/media/display.png
!/docs/media/bindings.png
!/docs/media/pause.png
!/docs/media/calibration.png
!/docs/media/practice-slow.gif
!/docs/media/practice-fast.gif
!/docs/media/skin-circle.gif
!/docs/media/skin-diamond.gif
!/docs/media/skin-bar.gif
!/docs/media/skin-arrows.gif

# Keep only the skin image families used by this game, plus skin.ini provenance.
/assets/skin/*.png
!/assets/skin/score-*@2x.png
!/assets/skin/combo-?@2x.png
!/assets/skin/mania-hit*.png
!/assets/skin/pause-retry.png
!/assets/skin/pause-back.png
!/assets/skin/ranking-*.png
/assets/skin/mania/*
!/assets/skin/mania/orbs/
!/assets/skin/mania/diamonds/
!/assets/skin/mania/bars/
!/assets/skin/mania/stage/
/assets/skin/mania/orbs/*
!/assets/skin/mania/orbs/note1.png
!/assets/skin/mania/orbs/note2.png
!/assets/skin/mania/orbs/note3.png
!/assets/skin/mania/orbs/key.png
!/assets/skin/mania/orbs/key_down.png
/assets/skin/mania/stage/*
!/assets/skin/mania/stage/stageleft.png
/assets/skin/*.wav

# In-project note variants used by the skin selector.
!/assets/skin/mania/orbs/mania-noteL.png
/assets/skin/mania/diamonds/*
/assets/skin/mania/bars/*
!/assets/skin/mania/diamonds/note1.png
!/assets/skin/mania/diamonds/note2.png
!/assets/skin/mania/diamonds/note3.png
!/assets/skin/mania/diamonds/key.png
!/assets/skin/mania/diamonds/key_down.png
!/assets/skin/mania/diamonds/mania-noteL.png
!/assets/skin/mania/bars/note1.png
!/assets/skin/mania/bars/note2.png
!/assets/skin/mania/bars/note3.png
!/assets/skin/mania/bars/key.png
!/assets/skin/mania/bars/key_down.png
!/assets/skin/mania/bars/mania-noteL.png

!/assets/skin/pause-continue.png
!/assets/skin/mania/arrows/
/assets/skin/mania/arrows/*
!/assets/skin/mania/arrows/left.png
!/assets/skin/mania/arrows/left-h.png
!/assets/skin/mania/arrows/k_left.png
!/assets/skin/mania/arrows/kd_left.png
!/assets/skin/mania/arrows/down.png
!/assets/skin/mania/arrows/down-h.png
!/assets/skin/mania/arrows/k_down.png
!/assets/skin/mania/arrows/kd_down.png
!/assets/skin/mania/arrows/up.png
!/assets/skin/mania/arrows/up-h.png
!/assets/skin/mania/arrows/k_up.png
!/assets/skin/mania/arrows/kd_up.png
!/assets/skin/mania/arrows/right.png
!/assets/skin/mania/arrows/right-h.png
!/assets/skin/mania/arrows/k_right.png
!/assets/skin/mania/arrows/kd_right.png
!/assets/skin/mania/arrows/mania-noteL.png

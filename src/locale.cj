package orz_mania

// Translate UI labels only; song metadata and skin artwork retain their original text.
func tr(a: App,value: String): String {
    if (!a.english) { return value }
    match (value) {
        case "设置" => "Settings"
        case "操作说明" => "How to play"
        case "曲库" => "Library"
        case "按键绑定" => "Key bindings"
        case "显示" => "Display"
        case "返回选曲" => "Song select"
        case "继续游玩" => "Resume"
        case "关闭菜单" => "Close menu"
        case "退出游戏" => "Quit game"
        case "Esc 关闭" => "Esc to close"
        case "Esc 菜单" => "Esc Menu"
        case "下落速度" => "Scroll speed"
        case "判定延迟" => "Timing offset"
        case "音乐音量" => "Music volume"
        case "自动演示" => "Autoplay"
        case "在选曲界面切换" => "Change in song select"
        case "语言" => "Language"
        case "负值：谱面落后音乐；正值：谱面领先音乐。每步 5 ms。" => "Negative: chart behind audio; positive: ahead. Step: 5 ms."
        case "选曲 / 开始" => "Select / Start"
        case "游玩" => "Gameplay"
        case "暂停 / 菜单" => "Pause / Menu"
        case "滚速与延迟" => "Speed / Offset"
        case "导入歌曲" => "Import songs"
        case "菜单键盘操作" => "Menu controls"
        case "Enter 或双击谱面开始；歌曲卡片展开/收起。" => "Enter or double-click to start. Click a song to expand."
        case "Esc 暂停；前奏期间按 Enter 可跳过。" => "Esc to pause. Enter to skip the intro."
        case "在设置中拖动滑块，或用 - / + 微调。" => "Drag a slider or click - / + to fine-tune."
        case "在曲库页导入文件夹、.osz 或 .osu。" => "Import a folder, .osz or .osu from Library."
        case "Tab 换页；↑ ↓ 选择；← → 调整。" => "Tab: page; ↑ ↓: select; ← →: adjust."
        case "结束当前游玩后，即可管理曲库。" => "Finish playing to manage the library."
        case "导入歌曲文件夹" => "Import song folder"
        case "导入 .osz / .osu" => "Import .osz / .osu"
        case "刷新曲库" => "Refresh library"
        case "也可以将歌曲文件或文件夹拖入窗口。" => "You can also drop song files or folders into the window."
        case "恢复默认" => "Reset defaults"
        case "已恢复默认" => "Defaults restored"
        case "按下新的按键，Esc 取消" => "Press a new key. Esc to cancel."
        case "点击按键修改绑定" => "Click a key to change its binding."
        case "该键不可用或与其他轨道重复" => "Key unavailable or already bound to another lane."
        case "帧率上限" => "Frame limit"
        case "不限制" => "Unlimited"
        case "自定义" => "Custom"
        case "自定义 FPS" => "Custom FPS"
        case "垂直同步" => "VSync"
        case "显示 FPS / 帧耗时" => "Show FPS / frame time"
        case "请输入 30–2000 之间的整数" => "Enter an integer from 30 to 2000."
        case "点击数值输入，Enter 确认，Esc 取消 · 30–2000" => "Click to edit. Enter: confirm; Esc: cancel. 30–2000."
        case "同步跟随显示器；同时限帧时取实际较低帧率。" => "VSync follows the display; the lower frame limit applies."
        case "当前渲染设备无法切换此同步模式" => "This renderer cannot use the requested sync mode."
        case "曲库为空，请在菜单中导入歌曲" => "Library is empty. Import songs from the menu."
        case "演示" => "Demo"
        case "Enter 跳过前奏" => "Enter to skip intro"
        case "无法跳过此前奏" => "Unable to skip this intro"
        case "暂无击打偏移" => "No hit timing data"
        case "返回" => "Back"
        case "再次挑战" => "Retry"
        case "设置文件无效，已使用默认值" => "Invalid settings file; defaults loaded."
        case "导入失败，检查路径或文件格式" => "Import failed. Check the path or file format."
        case _ => value
    }
}
